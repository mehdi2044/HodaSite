generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FxMode {
  AUTO_ACCEPT
  REQUIRE_APPROVAL
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum BackupStatus {
  RUNNING
  DONE
  FAILED
}

enum OffsiteStatus {
  PENDING
  OK
  FAILED
  NOT_CONFIGURED
}

enum RestoreStatus {
  PENDING
  VALIDATING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductGender {
  WOMEN
  MEN
  KIDS
  UNISEX
}

enum SizeScale {
  EU
  TR
  US
  CA
  INTL
}

model User {
  id           String                   @id @default(cuid())
  email        String                   @unique
  passwordHash String
  name         String
  isActive     Boolean                  @default(true)
  mfaSecret    String?
  mfaEnabled   Boolean                  @default(false)
  lastLoginAt  DateTime?
  sessions     Session[]
  roles        UserRole[]
  overrides    UserPermissionOverride[]
  auditLogs    AuditLog[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  accounts     Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  nameI18n    Json
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  permission String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roleId, permission])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  scope     Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
}

model UserPermissionOverride {
  id         String   @id @default(cuid())
  userId     String
  permission String
  allow      Boolean
  scope      Json?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, permission])
}

/// Append-only (D24). A Postgres trigger blocks UPDATE and DELETE; there is
/// no updatedAt.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model Job {
  id        String    @id @default(cuid())
  type      String
  payload   Json      @default("{}")
  runAt     DateTime  @default(now())
  attempts  Int       @default(0)
  status    JobStatus @default(PENDING)
  lockedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
}

model Backup {
  id              String        @id @default(cuid())
  kind            String
  status          BackupStatus
  offsiteStatus   OffsiteStatus @default(PENDING)
  offsiteSyncedAt DateTime?
  fileKey         String
  sizeBytes       BigInt
  dbSizeBytes     BigInt?
  mediaIncluded   Boolean       @default(true)
  verifiedAt      DateTime?
  verifyResult    Json?
  createdBy       String?
  startedAt       DateTime?
  finishedAt      DateTime?
  error           String?
  checksum        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model RestoreRequest {
  id              String        @id @default(cuid())
  backupId        String?
  uploadedFileKey String?
  mode            String        @default("FULL")
  requestedBy     String
  mfaVerifiedAt   DateTime?
  status          RestoreStatus @default(PENDING)
  log             String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model SystemAlert {
  id         String        @id @default(cuid())
  severity   AlertSeverity
  code       String
  message    String
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model SiteSettings {
  id          String   @id @default("default")
  brand       Json
  finance     Json
  contact     Json     @default("{}")
  seo         Json     @default("{}")
  social      Json     @default("{}")
  legal       Json     @default("{}")
  checkout    Json     @default("{}")
  maintenance Json     @default("{\"state\":\"off\"}")
  media       Json     @default("{\"purgeRetentionDays\":30}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ThemeSettings {
  id               String   @id @default("default")
  colors           Json
  fonts            Json
  radius           String   @default("12px")
  logoMediaId      String?
  logoDarkMediaId  String?
  faviconMediaId   String?
  emailLogoMediaId String?
  heroStyle        String   @default("editorial")
  darkMode         String   @default("off")
  headerStyle      String   @default("minimal")
  buttonStyle      String   @default("pill")
  customCss        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Market {
  id                   String     @id @default(cuid())
  code                 String     @unique
  name                 String
  currency             String
  isActive             Boolean    @default(true)
  salesPaused          Boolean    @default(false)
  defaultLocale        String
  enabledLocales       String[]
  markupPercent        Decimal    @default(0) @db.Decimal(18, 4)
  roundingRule         Json
  holdHours            Int
  paymentDeadlineHours Int
  fxMode               FxMode
  fxStaleHours         Int        @default(24)
  fxMaxJumpPercent     Decimal    @default(5) @db.Decimal(18, 4)
  volumetricDivisor    Int        @default(5000)
  supportChannels      Json       @default("{}")
  announcementBar      Json       @default("{\"enabled\":false}")
  seo                  Json       @default("{}")
  menus                Menu[]
  homepages            Homepage[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Integration {
  id        String   @id @default(cuid())
  key       String   @unique
  provider  String
  config    Json     @default("{}")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MediaFolder[] @relation("MediaFolderTree")
  media     Media[]
  createdAt DateTime      @default(now())
}

model Media {
  id              String             @id @default(cuid())
  kind            String
  storageKey      String             @unique
  originalName    String
  url             String
  width           Int?
  height          Int?
  bytes           Int
  mime            String
  altI18n         Json               @default("{}")
  variants        Json               @default("{}")
  uploadedBy      String?
  status          MediaStatus        @default(READY)
  folderId        String?
  folder          MediaFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags            String[]           @default([])
  blurDataUrl     String?
  processingError String?
  dominantColor   String?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  replacements    MediaReplacement[]
  categoryCovers  Category[]         @relation("CategoryCover")
  colorSwatches   Color[]            @relation("ColorSwatch")
  productMedia    ProductMedia[]
  variantMedia    VariantMedia[]

  @@index([deletedAt, createdAt])
  @@index([folderId])
  @@index([tags], type: Gin)
}

/// A storefront navigation slot. `marketId = null` is the global fallback;
/// a market-specific row replaces it for that market (Phase 01c).
model Menu {
  id        String     @id @default(cuid())
  key       String
  marketId  String?
  market    Market?    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  items     MenuItem[]
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([key, marketId])
  @@index([key, deletedAt])
  @@index([marketId])
}

model MenuItem {
  id          String     @id @default(cuid())
  menuId      String
  menu        Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      MenuItem?  @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    MenuItem[] @relation("MenuItemTree")
  labelI18n   Json
  linkType    String     @default("url")
  url         String?
  pageId      String?
  page        Page?      @relation(fields: [pageId], references: [id], onDelete: SetNull)
  referenceId String?
  target      String     @default("_self")
  enabled     Boolean    @default(true)
  visibleIn   String[]   @default([])
  sortOrder   Int        @default(0)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([menuId, parentId, sortOrder])
  @@index([pageId])
}

/// CMS page identity is stable while every public slug is localized.
/// `blocks` is validated and sanitized both at write and render time.
model Page {
  id        String     @id @default(cuid())
  slugI18n  Json
  titleI18n Json
  type      String     @default("static")
  status    String     @default("draft")
  seoI18n   Json       @default("{}")
  marketIds String[]   @default([])
  blocks    Json       @default("[]")
  menuItems MenuItem[]
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, deletedAt])
}

/// Ordered homepage composition. `marketId = null` is the global fallback.
model Homepage {
  id        String    @id @default(cuid())
  marketId  String?   @unique
  market    Market?   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  blocks    Json      @default("[]")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

/// Long-form and runtime UI translations (D09). UI overrides use
/// entityType=ui, entityId=global and a dot-separated message key in `field`.
model Translation {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String
  locale     String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, field, locale])
  @@index([entityType, entityId, locale])
}

/// Editable notification copy. Provider credentials are application
/// configuration and deliberately never live in this table (D31).
model NotificationTemplate {
  id          String   @id @default(cuid())
  key         String
  channel     String   @default("email")
  subjectI18n Json
  bodyI18n    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, channel])
  @@index([channel, isActive])
}

model MediaReplacement {
  id             String   @id @default(cuid())
  mediaId        String
  media          Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  baseStorageKey String
  storageKey     String   @unique
  url            String
  originalName   String
  bytes          Int
  mime           String
  width          Int?
  height         Int?
  variants       Json     @default("{}")
  blurDataUrl    String?
  dominantColor  String?
  status         String   @default("PENDING")
  error          String?
  oldStorageKey  String?
  oldVariants    Json?
  requestedBy    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([mediaId, createdAt])
  @@index([status])
}

/// Catalog taxonomy and product data introduced in Phase 02. Content records
/// follow D24 soft deletion; financial inventory is deliberately Phase 03.
model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameI18n  Json
  products  Product[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt, slug])
}

model Category {
  id              String        @id @default(cuid())
  parentId        String?
  parent          Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]    @relation("CategoryTree")
  slugI18n        Json
  titleI18n       Json
  descriptionI18n Json          @default("{}")
  seoI18n         Json          @default("{}")
  gender          ProductGender
  sortOrder       Int           @default(0)
  mediaId         String?
  media           Media?        @relation("CategoryCover", fields: [mediaId], references: [id], onDelete: SetNull)
  products        Product[]
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([parentId, sortOrder])
  @@index([gender, deletedAt])
  @@index([mediaId])
}

model Collection {
  id        String    @id @default(cuid())
  slug      String    @unique
  titleI18n Json
  products  Product[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt, slug])
}

model Color {
  id            String    @id @default(cuid())
  code          String    @unique
  nameI18n      Json
  hex           String
  swatchMediaId String?
  swatchMedia   Media?    @relation("ColorSwatch", fields: [swatchMediaId], references: [id], onDelete: SetNull)
  variants      Variant[]
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deletedAt, code])
  @@index([swatchMediaId])
}

model Size {
  id        String    @id @default(cuid())
  scale     SizeScale
  value     String
  groupKey  String
  sortOrder Int       @default(0)
  variants  Variant[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([scale, value, groupKey])
  @@index([groupKey, sortOrder])
}

model Product {
  id                          String                   @id @default(cuid())
  slugI18n                    Json
  titleI18n                   Json
  descriptionI18n             Json
  brandId                     String?
  brand                       Brand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId                  String
  category                    Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collections                 Collection[]
  gender                      ProductGender
  material                    String?
  fit                         String?
  season                      String?
  careI18n                    Json                     @default("{}")
  originCountry               String?
  tags                        String[]                 @default([])
  status                      ProductStatus            @default(DRAFT)
  basePriceAmount             Decimal                  @db.Decimal(18, 4)
  basePriceCurrency           String                   @default("USD")
  compareAtPriceAmount        Decimal?                 @db.Decimal(18, 4)
  defaultPurchaseCostAmount   Decimal?                 @db.Decimal(18, 4)
  defaultPurchaseCostCurrency String?
  weightGrams                 Int                      @default(250)
  seoI18n                     Json                     @default("{}")
  marketIds                   String[]                 @default([])
  searchText                  String                   @default("")
  searchVector                Unsupported("tsvector")?
  variants                    Variant[]
  attributes                  ProductAttribute[]
  media                       ProductMedia[]
  deletedAt                   DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  @@index([categoryId, status, deletedAt])
  @@index([brandId])
  @@index([gender, status])
  @@index([marketIds], type: Gin)
  @@index([tags], type: Gin)
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  valueI18n Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, key])
  @@index([productId])
}

model Variant {
  id               String         @id @default(cuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String         @unique
  barcode          String?        @unique
  colorId          String
  color            Color          @relation(fields: [colorId], references: [id], onDelete: Restrict)
  sizeId           String
  size             Size           @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  priceOverrideUsd Decimal?       @db.Decimal(18, 4)
  weightGrams      Int?
  dimensions       Json?
  isActive         Boolean        @default(true)
  media            VariantMedia[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([productId, colorId, sizeId])
  @@index([productId, isActive])
  @@index([colorId])
  @@index([sizeId])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@index([mediaId])
}

model VariantMedia {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, mediaId])
  @@index([variantId, sortOrder])
  @@index([mediaId])
}

model SizeGuide {
  id        String    @id @default(cuid())
  scope     String
  refId     String
  nameI18n  Json
  unit      String    @default("cm")
  tableI18n Json
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([scope, refId])
  @@index([scope, deletedAt])
}
