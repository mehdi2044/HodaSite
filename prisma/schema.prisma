generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FxMode {
  AUTO_ACCEPT
  REQUIRE_APPROVAL
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum BackupStatus {
  RUNNING
  DONE
  FAILED
}

enum OffsiteStatus {
  PENDING
  OK
  FAILED
  NOT_CONFIGURED
}

enum RestoreStatus {
  PENDING
  VALIDATING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductGender {
  WOMEN
  MEN
  KIDS
  UNISEX
}

enum SizeScale {
  EU
  TR
  US
  CA
  INTL
}

enum FxQuoteStatus {
  SUGGESTED
  ACTIVE
  REJECTED
  SUPERSEDED
}

enum FeeType {
  SHIPPING
  CUSTOMS
  SERVICE
  TAX
}

enum FeeMethod {
  FIXED
  PERCENT
  PER_KG
  WEIGHT_BRACKET
  VALUE_BRACKET
  PER_ITEM
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  RETURN_RESTOCK
  RETURN_QUARANTINE
  RETURN_DAMAGED
  WRITE_OFF
}

enum ReservationKind {
  HOLD
  VERIFICATION
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
}

model User {
  orderViews       Json                     @default("{}")
  id               String                   @id @default(cuid())
  email            String                   @unique
  passwordHash     String
  name             String
  isActive         Boolean                  @default(true)
  mfaSecret        String?
  mfaEnabled       Boolean                  @default(false)
  mfaPendingSecret String?
  mfaLastStep      BigInt?
  sessionVersion   Int                      @default(0)
  adminSessions    AdminSession[]
  recoveryCodes    MfaRecoveryCode[]
  lastLoginAt      DateTime?
  sessions         Session[]
  roles            UserRole[]
  overrides        UserPermissionOverride[]
  auditLogs        AuditLog[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  accounts         Account[]
  fxOverrides      FxOverride[]
  acceptedFxQuotes FxQuote[]                @relation("AcceptedFxQuotes")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  nameI18n    Json
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  permission String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roleId, permission])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  scope     Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
}

model UserPermissionOverride {
  id         String   @id @default(cuid())
  userId     String
  permission String
  allow      Boolean
  scope      Json?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, permission])
}

/// Append-only (D24). A Postgres trigger blocks UPDATE and DELETE; there is
/// no updatedAt.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model Job {
  id        String    @id @default(cuid())
  type      String
  payload   Json      @default("{}")
  runAt     DateTime  @default(now())
  attempts  Int       @default(0)
  status    JobStatus @default(PENDING)
  lockedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
}

model Backup {
  id              String        @id @default(cuid())
  kind            String
  status          BackupStatus
  offsiteStatus   OffsiteStatus @default(PENDING)
  offsiteSyncedAt DateTime?
  fileKey         String
  sizeBytes       BigInt
  dbSizeBytes     BigInt?
  mediaIncluded   Boolean       @default(true)
  verifiedAt      DateTime?
  verifyResult    Json?
  createdBy       String?
  startedAt       DateTime?
  finishedAt      DateTime?
  error           String?
  checksum        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model RestoreRequest {
  id              String        @id @default(cuid())
  backupId        String?
  uploadedFileKey String?
  mode            String        @default("FULL")
  requestedBy     String
  mfaVerifiedAt   DateTime?
  status          RestoreStatus @default(PENDING)
  log             String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model SystemAlert {
  id         String        @id @default(cuid())
  severity   AlertSeverity
  code       String
  message    String
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model SiteSettings {
  id          String   @id @default("default")
  brand       Json
  finance     Json
  contact     Json     @default("{}")
  seo         Json     @default("{}")
  social      Json     @default("{}")
  legal       Json     @default("{}")
  checkout    Json     @default("{}")
  maintenance Json     @default("{\"state\":\"off\"}")
  media       Json     @default("{\"purgeRetentionDays\":30}")
  inventory   Json     @default("{\"lowStockThreshold\":2}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ThemeSettings {
  id               String   @id @default("default")
  colors           Json
  fonts            Json
  radius           String   @default("12px")
  logoMediaId      String?
  logoDarkMediaId  String?
  faviconMediaId   String?
  emailLogoMediaId String?
  heroStyle        String   @default("editorial")
  darkMode         String   @default("off")
  headerStyle      String   @default("minimal")
  buttonStyle      String   @default("pill")
  customCss        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Market {
  invoiceSettings Json                @default("{}")
  paymentMethods  String[]            @default(["OFFLINE_BANK_TRANSFER"])
  bankAccounts    MarketBankAccount[]
  carts           Cart[]
  orders          Order[]
  orderSequence   OrderSequence?

  id                   String             @id @default(cuid())
  code                 String             @unique
  name                 String
  currency             String
  isActive             Boolean            @default(true)
  salesPaused          Boolean            @default(false)
  defaultLocale        String
  enabledLocales       String[]
  markupPercent        Decimal            @default(0) @db.Decimal(18, 4)
  roundingRule         Json
  holdHours            Int
  paymentDeadlineHours Int
  fxMode               FxMode
  fxStaleHours         Int                @default(24)
  fxMaxJumpPercent     Decimal            @default(5) @db.Decimal(18, 4)
  volumetricDivisor    Int                @default(5000)
  supportChannels      Json               @default("{}")
  announcementBar      Json               @default("{\"enabled\":false}")
  seo                  Json               @default("{}")
  priceIncludesTax     Boolean            @default(false)
  menus                Menu[]
  homepages            Homepage[]
  fxQuotes             FxQuote[]
  fxOverrides          FxOverride[]
  marketPrices         MarketPrice[]
  feeRules             FeeRule[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  shippingWorkflows    ShippingWorkflow[]
}

model FxQuote {
  id            String        @id @default(cuid())
  marketId      String
  market        Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  baseCurrency  String        @default("USD")
  quoteCurrency String
  rate          Decimal       @db.Decimal(18, 8)
  provider      String
  sourceField   String?
  status        FxQuoteStatus @default(SUGGESTED)
  jumpPercent   Decimal?      @db.Decimal(18, 4)
  fetchedAt     DateTime      @default(now())
  acceptedById  String?
  acceptedBy    User?         @relation("AcceptedFxQuotes", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@index([marketId, status, fetchedAt])
  @@index([quoteCurrency, status])
  @@index([acceptedById])
}

model FxOverride {
  id         String    @id @default(cuid())
  marketId   String
  market     Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  rate       Decimal   @db.Decimal(18, 8)
  validFrom  DateTime
  validUntil DateTime?
  note       String
  createdBy  String
  creator    User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())

  @@index([marketId, validFrom, validUntil])
}

model MarketPrice {
  id              String    @id @default(cuid())
  marketId        String
  market          Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         Variant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(18, 4)
  currency        String
  compareAtAmount Decimal?  @db.Decimal(18, 4)
  isActive        Boolean   @default(true)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([marketId, productId, validFrom])
  @@index([marketId, variantId, validFrom])
}

model FeeRule {
  selectable   Boolean   @default(false)
  id           String    @id @default(cuid())
  marketId     String
  market       Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  labelI18n    Json
  type         FeeType
  method       FeeMethod
  params       Json
  currency     String
  province     String?
  city         String?
  postalPrefix String?
  categoryIds  String[]  @default([])
  priority     Int       @default(0)
  minAmount    Decimal?  @db.Decimal(18, 4)
  maxAmount    Decimal?  @db.Decimal(18, 4)
  absorb       Boolean   @default(false)
  taxable      Boolean   @default(false)
  isActive     Boolean   @default(true)
  validFrom    DateTime  @default(now())
  validUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([marketId, isActive, type, priority])
  @@index([categoryIds], type: Gin)
}

model Warehouse {
  id           String          @id @default(cuid())
  code         String          @unique
  nameI18n     Json
  isActive     Boolean         @default(true)
  stock        StockItem[]
  lots         Lot[]
  movements    StockMovement[]
  reservations Reservation[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model StockItem {
  id                String          @id @default(cuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variantId         String
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  onHand            Int             @default(0)
  reserved          Int             @default(0)
  quarantinedQty    Int             @default(0)
  damagedQty        Int             @default(0)
  lowStockThreshold Int?
  movements         StockMovement[]
  reservations      Reservation[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([warehouseId, variantId])
  @@index([variantId])
}

model Lot {
  id                String          @id @default(cuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variantId         String
  variant           Variant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  qtyReceived       Int
  qtyRemaining      Int
  unitCostAmount    Decimal         @db.Decimal(18, 4)
  unitCostCurrency  String
  unitCostAmountTry Decimal         @db.Decimal(18, 4)
  unitCostAmountUsd Decimal         @db.Decimal(18, 4)
  fxRateSnapshot    Json
  landedCostAmount  Decimal?        @db.Decimal(18, 4)
  receivedAt        DateTime
  movements         StockMovement[]
  createdAt         DateTime        @default(now())

  @@index([variantId, warehouseId, receivedAt])
}

/// Immutable inventory ledger. PostgreSQL triggers reject UPDATE and DELETE.
model StockMovement {
  id          String            @id @default(cuid())
  stockItemId String
  stockItem   StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variantId   String
  variant     Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  lotId       String?
  lot         Lot?              @relation(fields: [lotId], references: [id], onDelete: Restrict)
  type        StockMovementType
  quantity    Int
  reason      String?
  referenceId String?
  createdBy   String?
  createdAt   DateTime          @default(now())

  @@index([variantId, warehouseId, createdAt])
  @@index([lotId])
}

model Reservation {
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  id          String            @id @default(cuid())
  stockItemId String
  stockItem   StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variantId   String
  variant     Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  kind        ReservationKind
  status      ReservationStatus @default(ACTIVE)
  quantity    Int
  referenceId String?
  expiresAt   DateTime?
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([orderId, status])
  @@index([status, expiresAt])
  @@index([variantId, warehouseId, status])
}

model Integration {
  id        String   @id @default(cuid())
  key       String   @unique
  provider  String
  config    Json     @default("{}")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MediaFolder[] @relation("MediaFolderTree")
  media     Media[]
  createdAt DateTime      @default(now())
}

model Media {
  invoices Invoice[]
  receipts Receipt[]

  id              String             @id @default(cuid())
  kind            String
  storageKey      String             @unique
  originalName    String
  url             String
  width           Int?
  height          Int?
  bytes           Int
  mime            String
  altI18n         Json               @default("{}")
  variants        Json               @default("{}")
  uploadedBy      String?
  status          MediaStatus        @default(READY)
  folderId        String?
  folder          MediaFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags            String[]           @default([])
  blurDataUrl     String?
  processingError String?
  dominantColor   String?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  replacements    MediaReplacement[]
  categoryCovers  Category[]         @relation("CategoryCover")
  colorSwatches   Color[]            @relation("ColorSwatch")
  productMedia    ProductMedia[]
  variantMedia    VariantMedia[]

  @@index([deletedAt, createdAt])
  @@index([folderId])
  @@index([tags], type: Gin)
}

/// A storefront navigation slot. `marketId = null` is the global fallback;
/// a market-specific row replaces it for that market (Phase 01c).
model Menu {
  id        String     @id @default(cuid())
  key       String
  marketId  String?
  market    Market?    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  items     MenuItem[]
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([key, marketId])
  @@index([key, deletedAt])
  @@index([marketId])
}

model MenuItem {
  id          String     @id @default(cuid())
  menuId      String
  menu        Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      MenuItem?  @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    MenuItem[] @relation("MenuItemTree")
  labelI18n   Json
  linkType    String     @default("url")
  url         String?
  pageId      String?
  page        Page?      @relation(fields: [pageId], references: [id], onDelete: SetNull)
  referenceId String?
  target      String     @default("_self")
  enabled     Boolean    @default(true)
  visibleIn   String[]   @default([])
  sortOrder   Int        @default(0)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([menuId, parentId, sortOrder])
  @@index([pageId])
}

/// CMS page identity is stable while every public slug is localized.
/// `blocks` is validated and sanitized both at write and render time.
model Page {
  id        String     @id @default(cuid())
  slugI18n  Json
  titleI18n Json
  type      String     @default("static")
  status    String     @default("draft")
  seoI18n   Json       @default("{}")
  marketIds String[]   @default([])
  blocks    Json       @default("[]")
  menuItems MenuItem[]
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, deletedAt])
}

/// Ordered homepage composition. `marketId = null` is the global fallback.
model Homepage {
  id        String    @id @default(cuid())
  marketId  String?   @unique
  market    Market?   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  blocks    Json      @default("[]")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

/// Long-form and runtime UI translations (D09). UI overrides use
/// entityType=ui, entityId=global and a dot-separated message key in `field`.
model Translation {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String
  locale     String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, field, locale])
  @@index([entityType, entityId, locale])
}

/// Editable notification copy. Provider credentials are application
/// configuration and deliberately never live in this table (D31).
model NotificationTemplate {
  id          String   @id @default(cuid())
  key         String
  channel     String   @default("email")
  subjectI18n Json
  bodyI18n    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, channel])
  @@index([channel, isActive])
}

model MediaReplacement {
  id             String   @id @default(cuid())
  mediaId        String
  media          Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  baseStorageKey String
  storageKey     String   @unique
  url            String
  originalName   String
  bytes          Int
  mime           String
  width          Int?
  height         Int?
  variants       Json     @default("{}")
  blurDataUrl    String?
  dominantColor  String?
  status         String   @default("PENDING")
  error          String?
  oldStorageKey  String?
  oldVariants    Json?
  requestedBy    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([mediaId, createdAt])
  @@index([status])
}

/// Catalog taxonomy and product data introduced in Phase 02. Content records
/// follow D24 soft deletion; financial inventory is deliberately Phase 03.
model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameI18n  Json
  products  Product[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt, slug])
}

model Category {
  id              String        @id @default(cuid())
  parentId        String?
  parent          Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]    @relation("CategoryTree")
  slugI18n        Json
  titleI18n       Json
  descriptionI18n Json          @default("{}")
  seoI18n         Json          @default("{}")
  gender          ProductGender
  sortOrder       Int           @default(0)
  mediaId         String?
  media           Media?        @relation("CategoryCover", fields: [mediaId], references: [id], onDelete: SetNull)
  products        Product[]
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([parentId, sortOrder])
  @@index([gender, deletedAt])
  @@index([mediaId])
}

model Collection {
  id        String    @id @default(cuid())
  slug      String    @unique
  titleI18n Json
  products  Product[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt, slug])
}

model Color {
  id            String    @id @default(cuid())
  code          String    @unique
  nameI18n      Json
  hex           String
  swatchMediaId String?
  swatchMedia   Media?    @relation("ColorSwatch", fields: [swatchMediaId], references: [id], onDelete: SetNull)
  variants      Variant[]
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deletedAt, code])
  @@index([swatchMediaId])
}

model Size {
  id        String    @id @default(cuid())
  scale     SizeScale
  value     String
  groupKey  String
  sortOrder Int       @default(0)
  variants  Variant[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([scale, value, groupKey])
  @@index([groupKey, sortOrder])
}

model Product {
  id                          String                   @id @default(cuid())
  slugI18n                    Json
  titleI18n                   Json
  descriptionI18n             Json
  brandId                     String?
  brand                       Brand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId                  String
  category                    Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collections                 Collection[]
  gender                      ProductGender
  material                    String?
  fit                         String?
  season                      String?
  careI18n                    Json                     @default("{}")
  originCountry               String?
  tags                        String[]                 @default([])
  status                      ProductStatus            @default(DRAFT)
  basePriceAmount             Decimal                  @db.Decimal(18, 4)
  basePriceCurrency           String                   @default("USD")
  compareAtPriceAmount        Decimal?                 @db.Decimal(18, 4)
  defaultPurchaseCostAmount   Decimal?                 @db.Decimal(18, 4)
  defaultPurchaseCostCurrency String?
  weightGrams                 Int                      @default(250)
  seoI18n                     Json                     @default("{}")
  marketIds                   String[]                 @default([])
  searchText                  String                   @default("")
  searchVector                Unsupported("tsvector")?
  variants                    Variant[]
  attributes                  ProductAttribute[]
  media                       ProductMedia[]
  marketPrices                MarketPrice[]
  deletedAt                   DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  @@index([categoryId, status, deletedAt])
  @@index([brandId])
  @@index([gender, status])
  @@index([marketIds], type: Gin)
  @@index([tags], type: Gin)
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  valueI18n Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, key])
  @@index([productId])
}

model Variant {
  cartItems  CartItem[]
  orderItems OrderItem[]

  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String          @unique
  barcode          String?         @unique
  colorId          String
  color            Color           @relation(fields: [colorId], references: [id], onDelete: Restrict)
  sizeId           String
  size             Size            @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  priceOverrideUsd Decimal?        @db.Decimal(18, 4)
  weightGrams      Int?
  dimensions       Json?
  isActive         Boolean         @default(true)
  media            VariantMedia[]
  marketPrices     MarketPrice[]
  stockItems       StockItem[]
  lots             Lot[]
  stockMovements   StockMovement[]
  reservations     Reservation[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([productId, colorId, sizeId])
  @@index([productId, isActive])
  @@index([colorId])
  @@index([sizeId])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@index([mediaId])
}

model VariantMedia {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, mediaId])
  @@index([variantId, sortOrder])
  @@index([mediaId])
}

model SizeGuide {
  id        String    @id @default(cuid())
  scope     String
  refId     String
  nameI18n  Json
  unit      String    @default("cm")
  tableI18n Json
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([scope, refId])
  @@index([scope, deletedAt])
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_VERIFICATION
  NEEDS_REVIEW
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  VOIDED
  FAILED
}

enum OrderKind {
  SALE
  EXCHANGE
}

enum ReturnedItemCondition {
  RESTOCK
  QUARANTINE
  DAMAGED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  RESOLVED
}

model Customer {
  id                  String          @id @default(cuid())
  email               String          @unique
  firstName           String          @default("")
  lastName            String          @default("")
  phone               String          @default("")
  locale              String          @default("en")
  preferredMarketId   String?
  isGuest             Boolean         @default(true)
  isActive            Boolean         @default(true)
  birthDate           DateTime?       @db.Timestamptz(3)
  gender              String?
  marketingConsent    Json            @default("{}")
  notes               String          @default("")
  deletionRequestedAt DateTime?       @db.Timestamptz(3)
  sessionVersion      Int             @default(0)
  addresses           Address[]
  carts               Cart[]
  orders              Order[]
  returns             ReturnRequest[]
  credits             StoreCredit[]
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  country    String
  province   String
  city       String
  line1      String
  line2      String   @default("")
  postalCode String   @default("")
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([customerId])
}

model AuthOtp {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  linkHash  String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  attempts  Int       @default(0)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([email, createdAt])
}

model AuthThrottle {
  id          String   @id
  attempts    Int      @default(0)
  windowStart DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model MarketBankAccount {
  id               String    @id @default(cuid())
  marketId         String
  market           Market    @relation(fields: [marketId], references: [id], onDelete: Restrict)
  label            String
  bankName         String
  holder           String
  accountNumber    String    @default("")
  iban             String    @default("")
  cardNumber       String    @default("")
  instructionsI18n Json      @default("{}")
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  payments         Payment[]
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  @@index([marketId])
}

model Cart {
  id          String     @id @default(cuid())
  tokenHash   String     @unique
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  marketId    String
  market      Market     @relation(fields: [marketId], references: [id], onDelete: Restrict)
  locale      String
  currency    String
  checkout    Json       @default("{}")
  revision    Int        @default(0)
  expiresAt   DateTime   @db.Timestamptz(3)
  completedAt DateTime?  @db.Timestamptz(3)
  items       CartItem[]
  order       Order?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([customerId, marketId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model OrderSequence {
  id        String   @id
  market    Market   @relation(fields: [id], references: [id], onDelete: Restrict)
  value     Int      @default(100000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Order {
  invoices          Invoice[]
  id                String          @id @default(cuid())
  number            String          @unique
  marketId          String
  market            Market          @relation(fields: [marketId], references: [id], onDelete: Restrict)
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cartId            String          @unique
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Restrict)
  guestTokenHash    String
  status            OrderStatus     @default(PENDING_PAYMENT)
  locale            String
  currency          String
  subtotalAmount    Decimal         @db.Decimal(18, 4)
  feeTotalAmount    Decimal         @db.Decimal(18, 4)
  discountAmount    Decimal         @default(0) @db.Decimal(18, 4)
  totalAmount       Decimal         @db.Decimal(18, 4)
  totalAmountTry    Decimal         @db.Decimal(18, 4)
  totalAmountUsd    Decimal         @db.Decimal(18, 4)
  fxSnapshot        Json
  bankSnapshot      Json
  contactSnapshot   Json
  holdExpiresAt     DateTime        @db.Timestamptz(3)
  paymentDeadlineAt DateTime        @db.Timestamptz(3)
  shippingAddress   Json
  billingAddress    Json
  customerNote      String          @default("")
  adminNote         String          @default("")
  placedAt          DateTime        @default(now()) @db.Timestamptz(3)
  paidAt            DateTime?       @db.Timestamptz(3)
  shippedAt         DateTime?       @db.Timestamptz(3)
  deliveredAt       DateTime?       @db.Timestamptz(3)
  cancelledAt       DateTime?       @db.Timestamptz(3)
  cancelReason      String?
  parentOrderId     String?
  parent            Order?          @relation("ExchangeOrders", fields: [parentOrderId], references: [id], onDelete: Restrict)
  exchanges         Order[]         @relation("ExchangeOrders")
  kind              OrderKind       @default(SALE)
  items             OrderItem[]
  fees              OrderFee[]
  events            OrderEvent[]
  payments          Payment[]
  reservations      Reservation[]
  returns           ReturnRequest[]
  refunds           Refund[]
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  shipments         Shipment[]

  @@index([marketId, status])
  @@index([customerId])
  @@index([parentOrderId])
  @@index([status, paymentDeadlineAt])
}

model OrderItem {
  id                    String         @id @default(cuid())
  orderId               String
  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId             String
  variant               Variant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productSnapshot       Json
  unitPriceAmount       Decimal        @db.Decimal(18, 4)
  currency              String
  quantity              Int
  lineTotalAmount       Decimal        @db.Decimal(18, 4)
  weightGrams           Int
  exchangeOfOrderItemId String?
  originalItem          OrderItem?     @relation("ExchangeItems", fields: [exchangeOfOrderItemId], references: [id], onDelete: Restrict)
  exchanges             OrderItem[]    @relation("ExchangeItems")
  returnItems           ReturnItem[]
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)
  shipmentItems         ShipmentItem[]

  @@index([orderId])
  @@index([variantId])
  @@index([exchangeOfOrderItemId])
}

model OrderFee {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type         FeeType
  label        String
  ruleId       String?
  amount       Decimal  @db.Decimal(18, 4)
  currency     String
  absorbed     Boolean
  ruleSnapshot Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([orderId])
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type       String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  note       String       @default("")
  userId     String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  @@index([orderId, createdAt])
}

model Payment {
  id            String             @id @default(cuid())
  orderId       String
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider      String             @default("offline")
  method        String             @default("OFFLINE_BANK_TRANSFER")
  status        PaymentStatus      @default(PENDING)
  amount        Decimal            @db.Decimal(18, 4)
  currency      String
  bankAccountId String?
  bankAccount   MarketBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  reference     String             @default("")
  submittedAt   DateTime?          @db.Timestamptz(3)
  reviewedBy    String?
  reviewedAt    DateTime?          @db.Timestamptz(3)
  rejectReason  String?
  receipts      Receipt[]
  refunds       Refund[]
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  @@index([orderId, status])
  @@index([bankAccountId])
}

model Receipt {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  mediaId   String   @unique
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  note      String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([paymentId])
}

model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount    Decimal  @db.Decimal(18, 4)
  currency  String
  method    String
  reason    String
  status    String   @default("PENDING")
  createdBy String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([orderId])
  @@index([paymentId])
}

model ReturnRequest {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type            String
  reasonCode      String
  note            String        @default("")
  status          ReturnStatus  @default(REQUESTED)
  resolution      String?
  refundId        String?
  exchangeOrderId String?
  items           ReturnItem[]
  credits         StoreCredit[]
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  @@index([orderId])
  @@index([customerId])
}

model ReturnItem {
  id                String                @id @default(cuid())
  returnRequestId   String
  returnRequest     ReturnRequest         @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  orderItemId       String
  orderItem         OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity          Int
  condition         ReturnedItemCondition
  exchangeVariantId String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)

  @@index([returnRequestId])
  @@index([orderItemId])
}

model StoreCredit {
  id             String         @id @default(cuid())
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount         Decimal        @db.Decimal(18, 4)
  balance        Decimal        @db.Decimal(18, 4)
  currency       String
  expiresAt      DateTime?      @db.Timestamptz(3)
  sourceReturnId String?
  sourceReturn   ReturnRequest? @relation(fields: [sourceReturnId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@index([customerId])
  @@index([sourceReturnId])
}

model AdminSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionVersion Int
  enrollmentOnly Boolean   @default(false)
  mfaVerifiedAt  DateTime? @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  userAgent      String    @default("")
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

enum ShippingLegType {
  INTERNATIONAL
  DOMESTIC
}

enum ShippingStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

model ShippingWorkflow {
  id        String                @id @default(cuid())
  marketId  String
  market    Market                @relation(fields: [marketId], references: [id], onDelete: Restrict)
  nameI18n  Json
  isDefault Boolean               @default(false)
  isActive  Boolean               @default(true)
  version   Int                   @default(0)
  legs      ShippingLegTemplate[]
  shipments Shipment[]
  createdAt DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @db.Timestamptz(3)

  @@index([marketId, isActive])
}

model ShippingLegTemplate {
  id                  String           @id @default(cuid())
  workflowId          String
  workflow            ShippingWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sortOrder           Int
  type                ShippingLegType
  labelI18n           Json
  carrierName         String           @default("")
  trackingUrlTemplate String           @default("")
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([workflowId, sortOrder])
}

model Shipment {
  id         String           @id @default(cuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  workflowId String
  workflow   ShippingWorkflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  nameI18n   Json
  status     ShippingStatus   @default(PENDING)
  version    Int              @default(0)
  items      ShipmentItem[]
  legs       ShipmentLeg[]
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  @@index([orderId, status])
}

model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model ShipmentLeg {
  id                  String          @id @default(cuid())
  shipmentId          String
  shipment            Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  sortOrder           Int
  type                ShippingLegType
  labelI18n           Json
  carrierName         String          @default("")
  service             String          @default("")
  trackingNumber      String          @default("")
  trackingUrlTemplate String          @default("")
  costAmount          Decimal         @default(0) @db.Decimal(18, 4)
  costCurrency        String
  status              ShippingStatus  @default(PENDING)
  shippedAt           DateTime?       @db.Timestamptz(3)
  eta                 DateTime?       @db.Timestamptz(3)
  deliveredAt         DateTime?       @db.Timestamptz(3)
  events              TrackingEvent[]
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([shipmentId, sortOrder])
}

model TrackingEvent {
  id          String         @id @default(cuid())
  legId       String
  leg         ShipmentLeg    @relation(fields: [legId], references: [id], onDelete: Restrict)
  at          DateTime       @default(now()) @db.Timestamptz(3)
  status      ShippingStatus
  description String         @default("")
  userId      String
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([legId, at])
}

model Invoice {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  version         Int
  snapshot        Json
  status          String    @default("PENDING")
  mediaId         String?   @unique
  media           Media?    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  generationToken String?
  generationUntil DateTime? @db.Timestamptz(3)
  requestedBy     String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([orderId, version])
}
