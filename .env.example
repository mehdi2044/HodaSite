# ---------- App ----------
APP_URL=http://localhost:3000            # آدرس سایت / Site URL
NODE_ENV=development
CRON_SECRET=change-me-random-string      # کلید محافظ زمان‌بند داخلی / protects /api/cron/tick
MAINTENANCE_SECRET=change-me-too         # فقط کانتینر ops می‌تواند حالت تعمیرات را عوض کند
PROJECT_ID=fashion-commerce

# ---------- First admin (used by seed) / اولین ادمین ----------
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---------- Database ----------
DATABASE_URL=postgresql://app:app@postgres:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# ---------- Storage / انبار فایل ----------
STORAGE_PROVIDER=local                   # local | s3
MEDIA_DIR=/data/media
S3_ENDPOINT=http://minio:9000
S3_BUCKET=media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_PUBLIC_URL=http://localhost:9000/media

# ---------- Email / ایمیل ----------
EMAIL_PROVIDER=noop                      # noop | smtp | resend
RESEND_API_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM="STYLE HUB <no-reply@example.com>"

# ---------- FX / نرخ ارز ----------
FX_PROVIDER_INTL=frankfurter             # USD→TRY/CAD : frankfurter | manual
FX_PROVIDER_IRT=navasan                  # USD→تومان : navasan | manual
NAVASAN_API_KEY=                          # کلید رایگان از api.navasan.tech (همان کلید پروژهٔ ارزینو)
NAVASAN_FIELD=usd_sell                    # usd_sell | usd_buy

# ---------- Finance currencies (D04) ----------
PRICING_BASE_CURRENCY=USD
FUNCTIONAL_CURRENCY=TRY
REPORTING_CURRENCY=USD

# ---------- Backups (off-site is REQUIRED for production) ----------
RESTORE_MAX_FILES=200000
RESTORE_MAX_UNCOMPRESSED_BYTES=53687091200
BACKUP_ROOT=/backups
BACKUP_OFFSITE_ENDPOINT=                 # e.g. https://fsn1.your-objectstorage.com (optional but recommended)
BACKUP_OFFSITE_KEY=
BACKUP_OFFSITE_SECRET=
BACKUP_OFFSITE_BUCKET=backups

# ---------- AI (Phase 06+) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
