# Copy to .env and fill in. Comments are on their own lines only — an inline
# "# ..." after a value is read as part of the value by Docker Compose.

# ---------- App ----------
APP_URL=http://localhost:3000
NODE_ENV=development
PROJECT_ID=fashion-commerce

# REQUIRED. Auth.js JWT signing secret — no fallback, the server refuses to
# start without it. Generate: openssl rand -base64 33
# راز امضای نشست ادمین؛ اجباری.
AUTH_SECRET=replace-with-a-long-random-value

# Protects /api/cron/tick  ·  کلید محافظ زمان‌بند داخلی
CRON_SECRET=change-me-random-string
# Only the ops container may toggle maintenance  ·  فقط کانتینر ops
MAINTENANCE_SECRET=change-me-too

# ---------- First admin (used by seed) / اولین ادمین ----------
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---------- Database ----------
DATABASE_URL=postgresql://app:app@postgres:5432/app

# Used only by `pnpm test` when running integration tests directly on the
# host (outside Docker). Matches docker-compose.dev.yml's fixed dev Postgres
# credentials (hoda/hoda/hoda) on its host-published port 55432 — leave as
# is for local dev; not used in CI or production.
# فقط برای اجرای `pnpm test` مستقیم روی هاست (نه داخل Docker) استفاده می‌شود.
# با اعتبارنامهٔ ثابت Postgres در docker-compose.dev.yml (hoda/hoda/hoda) و
# پورت منتشرشدهٔ آن (55432) هماهنگ است؛ برای توسعهٔ محلی همین‌طور بگذارید.
TEST_DATABASE_URL=postgresql://hoda:hoda@localhost:55432/hoda
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# ---------- Storage / انبار فایل ----------
# local  → disk volume (dev)
# s3     → any S3-compatible store (MinIO in compose, Cloudflare R2 in prod)
STORAGE_PROVIDER=local
MEDIA_DIR=/data/media
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_PUBLIC_URL=http://localhost:9000/media

# ---------- Email / ایمیل ----------
# noop | smtp | resend
EMAIL_PROVIDER=noop
RESEND_API_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM="STYLE HUB <no-reply@example.com>"

# ---------- FX / نرخ ارز ----------
# frankfurter | manual  (USD→TRY/CAD)
FX_PROVIDER_INTL=frankfurter
# navasan | manual  (USD→تومان بازار آزاد)
FX_PROVIDER_IRT=navasan
# کلید رایگان از api.navasan.tech
NAVASAN_API_KEY=
# usd_sell | usd_buy
NAVASAN_FIELD=usd_sell

# ---------- Finance currencies (D04) ----------
PRICING_BASE_CURRENCY=USD
FUNCTIONAL_CURRENCY=TRY
REPORTING_CURRENCY=USD

# ---------- Backups (off-site is REQUIRED for production) ----------
RESTORE_MAX_FILES=200000
RESTORE_MAX_UNCOMPRESSED_BYTES=53687091200
BACKUP_ROOT=/backups
# e.g. https://fsn1.your-objectstorage.com — leave empty to disable off-site
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_KEY=
BACKUP_OFFSITE_SECRET=
BACKUP_OFFSITE_BUCKET=backups

# ---------- AI (Phase 06+) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
